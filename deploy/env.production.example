# ============================================================================
# SmartPlanner — PRODUCTION .env TEMPLATE  (documentation only)
# ============================================================================
# HOW TO USE
#   Deploy this file ON THE PRODUCTION HOST as `.env` (do NOT place it at the
#   repo root of your local machine). Fill in the real values for your host.
#
#   cp deploy/env.production.example .env
#
#   NEVER commit a filled-in .env. The App Password, APP_KEY and DB password
#   must be created/per-host and kept off of version control.
#
#   After writing .env, generate a FRESH key on the host:
#       php artisan key:generate
#
# NOTE TO SELF (deployment): this template is the documented target posture.
# Do NOT copy the app's local `.env` — it has dev values and a dev key.
# ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_NAME=SmartPlanner
APP_ENV=production
APP_DEBUG=false                      # MUST be false in production (never expose stack traces)
APP_URL=https://YOUR_DOMAIN          # CHANGE: real public HTTPS domain (no trailing slash)

# Locale
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Faker locale (used only for local data seeding; harmless to keep)
APP_FAKER_LOCALE=fr_FR

# Maintenance
APP_MAINTENANCE_DRIVER=file

# ---------------------------------------------------------------------------
# PHP / logging
# ---------------------------------------------------------------------------
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                    # production: warning / error, NOT debug

# ---------------------------------------------------------------------------
# Database (MySQL on the production host)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_planner
DB_USERNAME=smart_planner             # CHANGE: dedicated app DB user
DB_PASSWORD=                          # CHANGE: strong, unique password (never commit)

# ---------------------------------------------------------------------------
# Session / cache / queue (production-safe drivers)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=                       # leave blank to use the host domain, or set the apex domain

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database                  # or "redis" if provisioned

# Redis (only if you switch CACHE_STORE/QUEUE_CONNECTION/SESSION to redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail (SMTP via Gmail App Password) — see EMAIL_SYSTEM in PROJECT_MAP
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=smartplanner.notifications@gmail.com   # the sending account
MAIL_PASSWORD=                        # CHANGE: real Gmail App Password (no spaces, NEVER commit)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=smartplanner.notifications@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AWS (unused by SmartPlanner — kept only because Laravel ships the keys)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Vite / frontend (matches the built asset bundle)
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# COOKIE SECURITY (production hardening) — set these on the host
# ---------------------------------------------------------------------------
# Override via config/session.php using these env variables:
#   SESSION_SECURE_COOKIE=true        -> session cookie only over HTTPS
#   SESSION_HTTP_ONLY=true            -> JS cannot read the cookie
#   SESSION_SAME_SITE=lax             -> default already; keep it
#
# These are the recommended production values. They are documented here so the
# operator sets them in the host's .env; they are NOT stored in the repo.
